{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "ProtectedPaths": [ "/api/agents", "/ws/agent", "/v1" ]
  },
  "Prometheus": {
    "ScrapeToken": ""
  },
  "Docker": {
    "AllowHostNetwork": false,
    "AllowHostIpc": false,
    "AllowedDevicePrefixes": [ "/dev/kfd", "/dev/dri/", "/dev/nvidia" ]
  },
  "CloudProviders": {
    "AllowPrivateEgress": false,
    "AllowedPrivateHosts": []
  }
}
