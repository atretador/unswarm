# GID of the host's docker socket group (run: stat -c '%g' /var/run/docker.sock)
DOCKER_GID=955

# Static API key seeded into the managed key store at startup (agent scope).
# Leave empty to skip; generate a key via the dashboard instead.
# UNSWARM_API_KEY=

# Optional: bootstrap/reset the admin password on startup
# UNSWARM_ADMIN_PASSWORD=

# Container host address for reaching model-container ports mapped to the host.
# Defaults to host.docker.internal (Docker) or 127.0.0.1 (bare metal).
# ContainerHost__Host=host.docker.internal
