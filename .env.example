# GID of the host's docker socket group (run: stat -c '%g' /var/run/docker.sock)
DOCKER_GID=955

# Optional: bootstrap/reset the admin password on startup
# UNSWARM_ADMIN_PASSWORD=

# Container host address for reaching model-container ports mapped to the host.
# Defaults to host.docker.internal (Docker) or 127.0.0.1 (bare metal).
# ContainerHost__Host=host.docker.internal

# Signals that the backend is running inside Docker.
# Set automatically in docker-compose.yml; only needed for custom deployments.
# RUNNING_IN_DOCKER=true

# Host scripts directory on the host filesystem (bind-mounted into the backend container).
# Defaults to ~/.config/unswarm/scripts/ (bare metal) or maps to /data/scripts (Docker).
# HOST_SCRIPTS_DIR=~/.config/unswarm/scripts
